# ==============================================================
# DataTrust Ops - Environment Variables Configuration
# ==============================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
# Local: mongodb://127.0.0.1:27017/datatrustops
# MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/datatrustops?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/datatrustops

# Optional AI / LLM Configuration for Incident Analysis
# If left empty, DataTrust Ops safely falls back to its deterministic rule-based analysis engine.
# Supported providers: Gemini API / OpenAI API compatible
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Upload Constraints
MAX_FILE_SIZE_MB=5
